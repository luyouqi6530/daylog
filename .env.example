# ============================================================
# Daylog 部署环境变量示例
# 使用方法：复制本文件为 .env 后按需修改
#   cp .env.example .env
# ============================================================

# ---- MySQL ----
# root 密码（生产环境务必修改为强密码）
MYSQL_ROOT_PASSWORD=daylog123456
# 宿主机访问 MySQL 的映射端口（避开本机 3306）
MYSQL_PORT=13306

# ---- Redis ----
# 宿主机访问 Redis 的映射端口（避开本机 6379）
REDIS_PORT=16379

# ---- JWT ----
# 生产密钥！建议生成强随机串：
#   Linux/macOS: openssl rand -base64 64
#   Windows:     certutil -encode 或直接使用一段 32 字符以上随机串
DAYLOG_JWT_SECRET=please-change-me-to-a-long-random-secret-string

# ---- DeepSeek（AI 周报）----
# 可选；不配置则 AI 周报功能不可用，其余功能正常
DEEPSEEK_API_KEY=

# ---- 端口映射 ----
# 前端访问入口（若本机 80 被占用，改为如 8088）
NGINX_PORT=80
# 后端直连调试入口（Swagger 生产已关闭，用于 API 调试）
BACKEND_PORT=18080
