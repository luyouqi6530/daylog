# ============================================================
# Daylog 部署环境变量示例
# 使用方法：复制本文件为 .env 后按需修改
#   cp .env.example .env
# ============================================================

# ---- MySQL ----
# root 密码（生产环境务必修改为强密码）
MYSQL_ROOT_PASSWORD=daylog123456
# 宿主机访问 MySQL 的映射端口；只绑 127.0.0.1，公网不可达
MYSQL_PORT=13306

# ---- Redis ----
# 宿主机访问 Redis 的映射端口；只绑 127.0.0.1，公网不可达
REDIS_PORT=16379

# ---- JWT ----
# 【必填，没有默认值】不设置则 docker compose 直接报错拒绝启动。
# 本仓库公开，绝不能复用示例值；换服务器就换一把新的。
#   Linux/macOS: openssl rand -base64 64
#   Windows(PowerShell): [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Max 256 } | ForEach-Object { [byte]$_ }))
DAYLOG_JWT_SECRET=please-change-me-to-a-long-random-secret-string

# ---- DeepSeek（AI 周报）----
# 可选；不配置则 AI 周报功能不可用，其余功能正常
DEEPSEEK_API_KEY=

# ---- 端口映射 ----
# 前端访问入口（唯一对公网开放的端口；若本机 80 被占用，改为如 8088）
NGINX_PORT=80
# 后端直连调试入口；只绑 127.0.0.1，服务器上用需走 SSH 隧道
BACKEND_PORT=18080
